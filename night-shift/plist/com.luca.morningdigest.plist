<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>__USER__.morningdigest</string>
    <key>ProgramArguments</key><array><string>/bin/bash</string><string>__DIR__/night-shift/morning-digest.sh</string></array>
    <key>StartCalendarInterval</key><dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <key>StandardOutPath</key><string>__HOME__/morning-digest.log</string>
    <key>StandardErrorPath</key><string>__HOME__/morning-digest.log</string>
</dict>
</plist>
