# Verifiche dichiarate del hub (dogfooding)
shellcheck night-shift/*.sh llm/*.sh tools/*.sh
bash -n night-shift/morning-gate.sh
bash tools/privacy-check.sh
bash tests/test-lib.sh
bash tests/test-gate-tools.sh
bash tests/test-ask-wrappers.sh
bash tests/test-privacy.sh
bash tools/sal-indice.sh && git diff --quiet SAL.md || { echo ⛔ indice SAL non rigenerato; exit 1; }
